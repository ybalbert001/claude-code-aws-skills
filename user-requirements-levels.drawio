<mxfile host="app.diagrams.net">
  <diagram name="用户管理三级要求" id="levels">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="用户管理安全与运营三级要求" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="225" y="30" width="400" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Level 1 -->
        <mxCell id="level1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="650" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="level1_badge" value="Level 1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="level1_title" value="凭证自动轮换" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="level1_desc" value="• 自动 Rotate Credentials&#xa;• 避免密钥长期暴露风险&#xa;• 定期更新访问凭证" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="145" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="level1_icon" value="🔐" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=36" vertex="1" parent="1">
          <mxGeometry x="680" y="130" width="50" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头1 -->
        <mxCell id="arrow1" value="" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#f5f5f5;strokeColor=#666666;width=20;endSize=6" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="425" y="220" as="sourcePoint"/>
            <mxPoint x="425" y="260" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        
        <!-- Level 2 -->
        <mxCell id="level2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="650" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="level2_badge" value="Level 2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="270" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="level2_title" value="单点登录 (SSO)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="270" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="level2_desc" value="• 统一身份认证入口&#xa;• 一次登录访问多个系统&#xa;• 简化用户访问体验" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="305" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="level2_icon" value="🔑" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=36" vertex="1" parent="1">
          <mxGeometry x="680" y="290" width="50" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头2 -->
        <mxCell id="arrow2" value="" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#f5f5f5;strokeColor=#666666;width=20;endSize=6" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="425" y="380" as="sourcePoint"/>
            <mxPoint x="425" y="420" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        
        <!-- Level 3 -->
        <mxCell id="level3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="650" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="level3_badge" value="Level 3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="level3_title" value="分账计费 (Cost Allocation)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="430" width="250" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="level3_desc" value="• 按用户/部门分账&#xa;• 精细化成本追踪&#xa;• 支持 Chargeback/Showback" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="200" y="465" width="530" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="level3_icon" value="💰" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=36" vertex="1" parent="1">
